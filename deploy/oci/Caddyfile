# Launchpad edge proxy.
#
# Homelab / Cloudflare Tunnel: TLS terminates at Cloudflare. Caddy stays HTTP-only
# so http://localhost:8080 (and tunnel → caddy:80) never redirect to https://localhost.
#
# LAUNCHPAD_SITE_ADDRESS (set by caddy-entrypoint.sh):
#   - Prefer :80 for tunnel / local checks
#   - Real hostname only when you want Caddy to obtain Let's Encrypt itself
#     (then set auto_https back on - see comment below)

{
	auto_https off
}

{$LAUNCHPAD_SITE_ADDRESS} {
	encode gzip zstd

	handle /api/v1/* {
		reverse_proxy api:8000
	}

	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}
	handle /redoc* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
