# Launchpad edge proxy.
#
# LAUNCHPAD_SITE_ADDRESS (set by caddy-entrypoint.sh):
#   - No DNS yet:              :80
#   - Real DNS hostname only:  launchpad.example.com
# Never use http://... or a bare IP here.

{$LAUNCHPAD_SITE_ADDRESS} {
	encode gzip zstd

	handle /api/v1/* {
		reverse_proxy api:8000
	}

	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}
	handle /redoc* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
