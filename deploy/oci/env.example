# Copy to .env in this directory:
#   cp env.example .env
# Then edit secrets and site address before: docker compose --env-file .env up -d --build

# --- Edge (Caddy) ---
# MUST be either:
#   :80                          (no DNS yet, or Cloudflare Tunnel terminates TLS)
#   launchpad.example.com        (DNS A/AAAA points here; Caddy gets Let's Encrypt)
# NEVER use http://... or a bare public IP here (that crash-loops Caddy).
LAUNCHPAD_SITE_ADDRESS=:80

# Host publish ports. Homelab default 8080 → http://localhost:8080 (container still :80).
# Cloudflare Tunnel should target http://caddy:80 on the Compose network (not host 8080).
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# Public origin used in CORS / invite links / GitHub App setup URL.
# Must match the URL in the browser (scheme + host, no trailing slash).
# Local:     http://127.0.0.1
# LAN:       http://192.168.1.10
# Domain:    https://launchpad-idp.online
LAUNCHPAD_PUBLIC_ORIGIN=http://127.0.0.1

# Optional: email for Caddy Let's Encrypt when LAUNCHPAD_SITE_ADDRESS is a real hostname
# (not needed when Cloudflare Tunnel terminates HTTPS and SITE_ADDRESS is :80).
# ACME_EMAIL=you@example.com

# --- Domain + Cloudflare Tunnel (homelab) ---
# When cloudflared proxies to http://caddy:80 on the Compose network:
#   LAUNCHPAD_SITE_ADDRESS=:80
#   LAUNCHPAD_PUBLIC_ORIGIN=https://launchpad-idp.online
#   USE_CLOUDFLARE_TUNNEL=true
#   ENVIRONMENT=production
#   AUTH_DEV_LOGIN_ENABLED=false
# Host-based previews (ws-*.yourdomain) for Kubernetes AND attach/compose:
#   PREVIEW_BASE_DOMAIN=launchpad-idp.online
#   USE_CLOUDFLARE_TUNNEL=true (or ENVIRONMENT=production)
#   Cloudflare public hostname *.launchpad-idp.online →
#     http://host.docker.internal:3080
#     (spelling: host.docker.internal — NOT docker.host.internal)
#   Requires k3d recreate once so port 3080 is mapped (scripts/k3s-up.sh).
# Attach/compose publish Docker ports; Launchpad creates an Ingress that bridges
# host.k3d.internal:<published_port> so Open-app uses the same ws-{id}.domain URL.
# Optional: PREVIEW_DOCKER_HOST_IP=172.18.0.1 if CoreDNS alias lookup fails.
# Quick-tunnel fallback only (when Ingress bridge unavailable):
#   PREVIEW_TUNNEL_MODE=cloudflared
# Local Adminer (loopback only): http://127.0.0.1:8082  (ADMINER_PORT)
USE_CLOUDFLARE_TUNNEL=false
ENVIRONMENT=development
PREVIEW_BASE_DOMAIN=
PREVIEW_TUNNEL_MODE=off
PREVIEW_INGRESS_HTTP_PORT=3080
# PREVIEW_DOCKER_HOST_IP=
ADMINER_PORT=8082
# PREVIEW_PUBLIC_BASE_URL defaults to LAUNCHPAD_PUBLIC_ORIGIN when set below in compose.

# --- Database ---
POSTGRES_USER=launchpad
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=launchpad

# --- Auth / secrets (required - do not use defaults in production) ---
JWT_SECRET=change-me-to-a-long-random-jwt-secret
SECRETS_ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key
# false for anything internet-facing / Cloudflare Tunnel.
AUTH_DEV_LOGIN_ENABLED=true

# Interactive cloud Connect (Settings → browser login). API must run on the user machine.
# GCP: Google Cloud Console → APIs & Services → Credentials → OAuth client → Desktop app
# Also add scope https://www.googleapis.com/auth/cloud-platform on the OAuth consent screen.
# After changing scopes: revoke the app at https://myaccount.google.com/permissions then Connect again.
# GCP_OAUTH_CLIENT_ID=....apps.googleusercontent.com
# GCP_OAUTH_CLIENT_SECRET=
# Azure: Entra app registration (public/native client) with mobile+desktop redirect
# AZURE_OAUTH_CLIENT_ID=
# AZURE_OAUTH_TENANT_ID=common
# CLOUD_OAUTH_TIMEOUT_SECONDS=180

# --- App / Local Sandbox (k3d on host Docker) ---
LOG_LEVEL=INFO
# true on 16GB+ laptop/server with Docker. Set false on tiny Always Free VMs.
KUBERNETES_ENABLED=true
LOCAL_K8S_ENGINE=k3s
KIND_AUTO_MANAGE=true
KIND_CLUSTER_NAME=launchpad
PREVIEW_NODE_PORT_MIN=30080
PREVIEW_NODE_PORT_MAX=30089
# How api/worker containers REACH the k3d apiserver (client address). This is a
# gateway alias resolved via extra_hosts "host.docker.internal:host-gateway".
K3D_API_HOST=host.docker.internal
K3D_API_PORT=6445
# Celery worker throughput knobs (increase with CPU cores and queue depth).
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
# Host address k3d BINDS/publishes the apiserver on. Leave 0.0.0.0 - it is the
# only value that binds on both Docker Desktop (Mac/Linux) and plain Linux Docker.
# Do NOT set this to host.docker.internal / 192.168.65.254: that gateway alias is
# not a bindable interface and fails with "can't assign requested address".
K3D_API_BIND_HOST=0.0.0.0
# Optional: advertise NodePort host for Open app (LAN IP of this laptop)
# PREVIEW_NODE_HOST=192.168.1.10
# Docker socket on the host (Linux default). Docker Desktop Mac usually still exposes this path.
DOCKER_SOCK=/var/run/docker.sock
DEFAULT_WORKLOAD_IMAGE=
TTL_REAPER_INTERVAL_SECONDS=300

# --- Gemini AI (preview analyzer, workspace file AI, Dockerfile review) ---
# Get a key at https://aistudio.google.com/apikey
# Without this, AI features fall back to heuristics only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set false to fail hard when Gemini is down instead of silent heuristic fallback.
PREVIEW_ANALYZER_HEURISTIC_FALLBACK=true

# Optional GitHub App / GitLab OAuth - see apps/api/.env.example
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=
# WEBHOOK_SECRET=
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=
# GITLAB_OAUTH_REDIRECT_URI=https://launchpad-idp.online/integrations/gitlab
