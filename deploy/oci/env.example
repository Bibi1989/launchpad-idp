# Copy to .env in this directory:
#   cp env.example .env
# Then edit secrets and site address before: docker compose --env-file .env up -d --build

# --- Edge (Caddy) ---
# Real DNS name pointing at the VM → automatic HTTPS, e.g. launchpad.example.com
# No domain yet → use plain HTTP on :80
LAUNCHPAD_SITE_ADDRESS=:80
# Optional ACME contact (only needed with a real domain)
ACME_EMAIL=

# Public origin used in CORS / invite links (must match how users open the UI)
# Examples: https://launchpad.example.com   or   http://130.61.x.x
LAUNCHPAD_PUBLIC_ORIGIN=http://92.5.2.108

# --- Database ---
POSTGRES_USER=launchpad
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=launchpad

# --- Auth / secrets (required - do not use defaults in production) ---
JWT_SECRET=change-me-to-a-long-random-jwt-secret
SECRETS_ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key
AUTH_DEV_LOGIN_ENABLED=true

# --- App ---
LOG_LEVEL=INFO
KUBERNETES_ENABLED=false
DEFAULT_WORKLOAD_IMAGE=nginx:1.27-alpine
TTL_REAPER_INTERVAL_SECONDS=300

# Optional GitHub App / OIDC / GitLab - see apps/api/.env.example
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# WEBHOOK_SECRET=
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=
# GITLAB_OAUTH_REDIRECT_URI=https://your-host/integrations/gitlab
