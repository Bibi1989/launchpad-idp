DATABASE_URL=postgresql+asyncpg://launchpad:launchpad@localhost:5432/launchpad
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Distributed state lock (prevents concurrent provision/rebuild/teardown)
STATE_LOCK_TIMEOUT_SECONDS=900
STATE_LOCK_BLOCKING_TIMEOUT_SECONDS=0
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
COST_ESTIMATE_HOURLY=0.4200
# Preview governance
MAX_CONCURRENT_ENVIRONMENTS=5
PREVIEW_SOFT_COST_CAP=25.00
TTL_EXTEND_HOURS_DEFAULT=8
TTL_WARNING_HOURS=2
TTL_MAX_TOTAL_HOURS_FROM_CREATE=168
PROVISION_STEP_DELAY_SECONDS=0.75
KUBERNETES_ENABLED=false
KUBERNETES_IN_CLUSTER=false
# After `make kind-up`, set ENABLED=true and CONTEXT=kind-launchpad:
# KUBERNETES_CONTEXT=kind-launchpad
# KUBERNETES_KUBECONFIG_PATH=
# PREVIEW_NODE_HOST=127.0.0.1
# PREVIEW_NODE_PORT_MIN=30080
# PREVIEW_NODE_PORT_MAX=30084
# KUBERNETES_READY_TIMEOUT_SECONDS=120
# PROVISION_STEP_DELAY_SECONDS=0
SSE_POLL_INTERVAL_SECONDS=0.5
TTL_REAPER_INTERVAL_SECONDS=300
# Periodic comparison of live K8s preview workloads vs control-plane state
DRIFT_SCAN_ENABLED=true
DRIFT_SCAN_INTERVAL_SECONDS=600
SECRETS_ENCRYPTION_KEY=dev-only-change-me-to-a-long-random-string
IAC_WORKSPACE_ROOT=/tmp/launchpad-workspaces
SANDBOX_DOCKER_ENABLED=false
# GitHub App (preferred for repo bootstrap)
GITHUB_APP_ID=
# PEM contents, escaped newlines (\n), or base64-encoded PEM (single line):
GITHUB_APP_PRIVATE_KEY=
# Or path to PEM file instead of inline key:
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/launchpad-app.pem
GITHUB_APP_SLUG=
# Optional default when only one org is used:
# GITHUB_APP_INSTALLATION_ID=
# Must match the GitHub App "Setup URL" so Connect returns to Launchpad:
GITHUB_APP_SETUP_URL=http://localhost:3000/integrations/github
# Deprecated fallback — prefer GitHub App:
GITHUB_PAT=
# GitHub push webhook HMAC secret (GitOps rebuild)
WEBHOOK_SECRET=dev-webhook-secret-change-me
JWT_SECRET=dev-only-jwt-secret-change-me-in-production
JWT_EXPIRE_MINUTES=1440
# Which backend serves the API: fastapi (default) | nestjs. FastAPI runs on :8000;
# the NestJS backend (apps/api-nest) runs on :8001 and shares this JWT_SECRET.
# To use NestJS, run `make api-nest` and start the web with
# NUXT_PUBLIC_API_BASE=http://localhost:8001/api/v1.
ACTIVE_BACKEND=fastapi
AUTH_DEV_LOGIN_ENABLED=true
# OIDC (optional) — Authorization Code SSO
OIDC_ENABLED=false
# OIDC_ISSUER_URL=https://login.microsoftonline.com/{tenant}/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# OIDC_SCOPES=openid profile email
# OIDC_PROVIDER_NAME=Microsoft
# Claim that carries IdP groups (Azure often uses "groups" or "roles")
# OIDC_GROUP_CLAIM=groups
# Optional global fallback map + target org slug:
# OIDC_GROUP_ROLE_MAP={"launchpad-admins":"admin","launchpad-devs":"member"}
# OIDC_DEFAULT_ORG_SLUG=acme
# Invites (email optional — invite_url returned when SMTP unset)
INVITE_BASE_URL=http://localhost:3000/invite
INVITE_TTL_HOURS=168
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
DEFAULT_WORKLOAD_IMAGE=nginx:1.27-alpine
# Build preview images from git repos (Dockerfile at repo root; requires Docker + git)
PREVIEW_BUILD_ENABLED=false
# PREVIEW_BUILD_DOCKERFILE=Dockerfile
# PREVIEW_BUILD_IMAGE_PREFIX=launchpad-preview
# PREVIEW_IMAGE_REGISTRY=localhost:5001/launchpad
# PREVIEW_BUILD_KIND_LOAD=true
# PREVIEW_BUILD_TIMEOUT_SECONDS=900
# Launch Preview Analyzer (Gemini structured diagnostics)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# PREVIEW_ANALYZER_HEURISTIC_FALLBACK=true

# Hybrid local/edge agent nodes.
# Public API origin agents reach the control plane at (the API, NOT the Nuxt web app).
# /install.sh and /api/v1/nodes/* are served by the API. In local dev the API is on :8000.
# AGENT_CONTROL_PLANE_URL=http://localhost:8000
# Public wss:// origin agents dial back to (defaults to the control-plane URL, ws/wss scheme).
# AGENT_WS_PUBLIC_URL=
# AGENT_IMAGE=ghcr.io/launchpad/agent:latest
# AGENT_HEARTBEAT_INTERVAL_SECONDS=10
