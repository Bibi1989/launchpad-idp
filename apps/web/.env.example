# Control plane backend selection: "fastapi" (port 8000, default) or "nest" / "nestjs" (port 8001).
ACTIVE_BACKEND=fastapi

# REST stays same-origin via Nitro/Vite proxy (default /api/v1).
# NUXT_PUBLIC_API_BASE=/api/v1

# WebSocket base (automatically uses port 8001 when ACTIVE_BACKEND=nest, or 8000 when ACTIVE_BACKEND=fastapi).
# NUXT_PUBLIC_WS_BASE=ws://127.0.0.1:8000
