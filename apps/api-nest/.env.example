# NestJS Control Plane Environment Configuration (apps/api-nest)

# Server Port (FastAPI uses 8000, NestJS uses 8001)
NEST_PORT=8001

# Database URL (Plain PostgreSQL URL for Drizzle ORM)
DATABASE_URL=postgresql://launchpad:launchpad@localhost:5432/launchpad

# Redis Connection
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=dev-only-jwt-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Security & Secrets Encryption
SECRETS_ENCRYPTION_KEY=dev-only-change-me-to-a-long-random-string

# Storage Directories
REPO_IMPORT_ROOT=/tmp/launchpad/imports
WORKSPACES_ROOT=/tmp/launchpad/workspaces

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SETUP_URL=http://localhost:3000/integrations/github
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Feature Flags
AUTH_DEV_LOGIN_ENABLED=true
INVITE_BASE_URL=http://localhost:3000/invite
DEFAULT_WORKLOAD_IMAGE=nginx:1.27-alpine
